# ==============================================================================
# DevOpsHub — Master Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values for your environment.
# NEVER COMMIT YOUR REAL .env FILE WITH ACTUAL SECRETS TO GIT.
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
NODE_ENV=development
PORT=5000

# --- DATABASE CONFIGURATION (MongoDB Atlas) ---
# Replace with your actual MongoDB Atlas connection URI:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/devopshub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_address>/devopshub?retryWrites=true&w=majority

# --- AUTHENTICATION & SECURITY ---
# A strong random secret key for signing JWT tokens (min 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# --- CORS & CLIENT URL ---
# URL where your frontend is hosted or running
CLIENT_URL=http://localhost:5173

# --- GITHUB ACTIONS INTEGRATION (Optional - for real workflow telemetry) ---
# Your GitHub Personal Access Token (with repo or workflow read scope)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
# Target GitHub repository in format: owner/repo
GITHUB_REPO=your-github-username/your-repo-name

# --- SERVER / EC2 HOST MONITORING CONFIGURATION ---
SERVER_NAME=EC2-Production-Node-01
METRICS_COLLECTION_INTERVAL_MS=10000

# --- AWS CLOUD INTEGRATION (Optional - can also be provided directly via UI) ---
# AWS IAM User credentials with AmazonEC2ReadOnlyAccess
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=all
# AWS_SESSION_TOKEN=optional_sts_token

# --- DOCKER COMPOSE CONFIGURATION (For EC2 & Local Containerization) ---
VITE_API_URL=http://localhost:5000/api
